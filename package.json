{
  "name": "@automerge/keyhive-react",
  "version": "0.1.0-alpha.2",
  "description": "React components and hooks for keyhive access control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtfmumm/keyhive-react.git"
  },
  "homepage": "https://github.com/jtfmumm/keyhive-react#readme",
  "bugs": "https://github.com/jtfmumm/keyhive-react/issues",
  "keywords": [
    "keyhive",
    "automerge",
    "react",
    "access-control",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/keyhive-react.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:css && pnpm run check",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o dist/keyhive-react.css --minify",
    "check": "pnpm run check:isolation && pnpm run check:prefix",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:prefix": "node scripts/check-prefix.mjs",
    "tsc": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "app": "pnpm --filter component-test-app dev",
    "app:build": "pnpm --filter component-test-app build",
    "app:preview": "pnpm --filter component-test-app preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tsc:e2e": "tsc -p e2e/tsconfig.json"
  },
  "peerDependencies": {
    "@automerge/automerge-repo-keyhive": "0.5.0-alpha.3",
    "@automerge/react": "2.6.0-subduction.40",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@automerge/automerge-repo-keyhive": "0.5.0-alpha.3",
    "@automerge/react": "2.6.0-subduction.40",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.60.0",
    "@types/node": "22.19.4",
    "@types/react": "^18.3.25",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
